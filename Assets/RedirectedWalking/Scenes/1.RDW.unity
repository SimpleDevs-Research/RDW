MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1332807519}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69dfdd7fce5430e459c8e4da7b7d6fed, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  redirector: {fileID: 0}
  active: 1
  description: Saccade Gain refers to the gain obtained while the user's gaze is
    performing a saccade maneuver. Saccades are ballistic in nature and behave in
    a way that lets us take advantage of the "saccadic suppression" phenomenon experienced
    during them. According to Sun et al., the recommended saccade gain allowed is
    approximately 12.6 degrees/sec if the saccade detection threshold (the speed
    the eye rotates) is 180 degrees/sec
  saccadeThreshold: 180
  saccadeGain: 12.6
