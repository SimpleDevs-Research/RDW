--- !u!114 &908227480
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 908227478}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 22c1b5690346617448109afe52a6aa41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Description: 'The RouteManager is a Singleton manager that acts as the simulation''s...
    route manager. All that means is that it performs the necessary operations for:


    1.
    Initializing all routes in the simulation at the beginning of runtime,

    2.
    Interacting with `PathRegion` colliders placed around the scene to update its
    routes, and

    3. Providing getter functions for pedestrians to query for an
    optimal path, given their personality + route condition.


    For your part,
    the minimum work you need to do is ensure that `Routes` and a `PathRegion` prefab
    are set in the Inspector.'
  _kdTree: {fileID: 908227479}
  _routes:
  - name: EndNode North - EndNode South
    node1: {fileID: 403308244}
    node2: {fileID: 170343454}
    is_active: 1
    pathWidth: 2.5
    baseCost: 0
    safety: 0
    pathRegion: {fileID: 0}
    distance: 0
    density: 0
    dirtiness: 0
    computedCost: 0
  _pathRegionPrefab: {fileID: 841824682806198145, guid: 2c14f85d7c0291347a363d25337543d1, type: 3}
  _pathRegionParent: {fileID: 455480962}
  _useDijkstras: 1
  _considerDistance: 1
  _distanceWeight: 1
  _considerSafety: 1
  _safetyWeight: 1
  _considerCrowdDensity: 1
  _crowdDensityWeight: 1
  _considerDirtiness: 1
  _dirtinessWeight: 1
