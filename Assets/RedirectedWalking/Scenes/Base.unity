  m_Script: {fileID: 11500000, guid: 791c976d047d70b4ea3a61d9b932cb41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Description: 'This is a custom mesh that creates a rectangular prism; the edges
    connecting the top and bottom faces are beveled. This mesh is dynamically sized
    and will be auto-rebuilt whenever you change one of the following:


    - Changing
    the transform''s local scale,

    - Changing the bevel radius,

    - Smoothness
    of the bevel,

    - Whether the top and bottom faces are generated,

    - Inversion
    of the mesh normals, and

    - Whether the mesh''s origin is at the bottom or
    center.


    Don''t mess with the `convex` parameter of the attached Mesh Collider;
    this script will modify that parameter automatically.'
  cornerRadius: 1.5
  radialSegments: 16
  onlySides: 1
  inverted: 1
  meshOrigin: 1
